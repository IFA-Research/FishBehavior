{
  "experiment_name": "datasetA_bilstm_seq10",
  "data": {
    "dataset_name": "dataset_a",
    "base_dir": "./Dataset/Resized/",
    "seq_len": 10,
    "step": 5,
    "img_height": 224,
    "img_width": 224,
    "batch_size": 2,
    "validation_split": 0.2,
    "classes": ["Medium", "Strong", "Weak", "None"]
  },
  "model": {
    "backbone": "apple/mobilevit-small",
    "temporal_type": "bilstm",
    "hidden_size": 256,
    "num_classes": 4,
    "dropout": 0.3
  },
  "train": {
    "lr": 1e-4,
    "weight_decay": 5e-6,
    "epochs": 100,
    "accumulation_steps": 16,
    "label_smoothing": 0.1
  },
  "augmentations": {
    "Flip": true,
    "Noise": true,
    "Noise_Variance": 0.01,
    "Random_Crop": true,
    "Gaussian_Blur": true,
    "Random_Masking": true,
    "Masking_Size": [32, 32],
    "Masking_Per_Image": 4
  }
}
